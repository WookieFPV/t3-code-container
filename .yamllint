---
# yamllint, tuned for playbooks that carry a lot of prose.
#
# The comments in this repo are the documentation — the reasoning that would
# otherwise only exist in a commit message nobody reads. So the rules that fight
# long explanatory comments are relaxed, and the ones that catch real YAML
# mistakes are not.

extends: default

ignore: |
  .github/

rules:
  # Task names and fail_msg strings are prose. Wrapping them to 80 would mean
  # breaking sentences at arbitrary points.
  line-length:
    max: 100
    allow-non-breakable-words: true
    allow-non-breakable-inline-mappings: true

  # `- {role: base, tags: [base]}` is more readable as a role list than four
  # lines per role, and the flow form is deliberate there. `1` rather than `0`
  # because that is what ansible-lint requires of a custom yamllint config, and
  # it is an upper bound — the zero-space form above still passes.
  braces:
    max-spaces-inside: 1
  brackets:
    max-spaces-inside: 1

  # Both required by ansible-lint, and both worth having: a bare 0755 in YAML is
  # the decimal 755, which is why every `mode:` in this repo is a quoted string.
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true

  # Comments in this repo are often indented to the block they explain rather
  # than to the following line. Required false by ansible-lint.
  comments-indentation: false

  # The role lists in playbooks/ are column-aligned, which means padding after
  # the comma. A profile's role list is the thing people read most often in this
  # repo and the alignment is what makes it scan as a table.
  commas:
    max-spaces-after: -1

  comments:
    require-starting-space: true
    min-spaces-from-content: 1

  # Ansible convention: `true`/`false`, not `yes`/`no`.
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
